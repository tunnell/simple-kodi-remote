#!/usr/bin/env zsh
#
# skr - Simple Kodi Remote
# A TUI remote control for Kodi using kodi-send
#
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) tunnell
#

setopt errexit nounset pipefail
zmodload zsh/datetime  # provides $EPOCHREALTIME

# Configuration
typeset -g CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/skr/config"
typeset -g KODI_HOST="localhost"
# Multi-tap seek window (seconds): taps within this window stack (10s/100s/1000s)
typeset -g SEEK_WINDOW="0.4"

# Terminal state
typeset -g TERM_COLS=0
typeset -g TERM_ROWS=0
typeset -g LAST_COMMAND="Ready"
typeset -g LAST_TIMESTAMP=""

# Multi-tap seek state
typeset -g SEEK_DIR=0       # 1 = forward, -1 = backward, 0 = none pending
typeset -g SEEK_COUNT=0     # number of taps in the current burst (max 3)
typeset -g SEEK_DEADLINE=0  # $EPOCHREALTIME after which the burst commits

# Decoded key from read_key()
typeset -g KEY=""

# Colors
readonly RESET=$'\033[0m'
readonly BOLD=$'\033[1m'
readonly DIM=$'\033[2m'
readonly BLUE=$'\033[34m'
readonly CYAN=$'\033[36m'
readonly GREEN=$'\033[32m'
readonly YELLOW=$'\033[33m'
readonly WHITE=$'\033[37m'

readonly MIN_COLS=42
readonly MIN_ROWS=22

load_config() {
    [[ -f "$CONFIG_FILE" ]] || return 0
    while IFS='=' read -r key value; do
        [[ -z "$key" || "$key" == \#* ]] && continue
        key="${key## }"; key="${key%% }"
        value="${value## }"; value="${value%% }"
        case "$key" in
            host) KODI_HOST="$value" ;;
            seek_window) SEEK_WINDOW="$value" ;;
        esac
    done < "$CONFIG_FILE"
}

check_deps() {
    if ! command -v kodi-send &>/dev/null; then
        print -u2 "kodi-send not found. Install: sudo pacman -S kodi-eventclients"
        exit 1
    fi
}

cleanup() {
    stty sane 2>/dev/null || true
    tput cnorm 2>/dev/null || true
    tput clear 2>/dev/null || true
    print "Goodbye!"
}

get_term_size() {
    TERM_COLS=$(tput cols)
    TERM_ROWS=$(tput lines)
}

move_to() { tput cup "$1" "$2"; }

# Discard any input buffered while we were busy. Over SSH a held key
# (e.g. volume) auto-repeats faster than kodi-send round-trips, so without
# this the queue keeps draining after the key is released.
flush_input() {
    local d
    while IFS= read -rsk1 -t 0.001 d 2>/dev/null; do :; done
}

send_kodi() {
    local action="$1" name="${2:-$1}"
    LAST_TIMESTAMP=$(date +%H:%M:%S)
    if kodi-send --host="$KODI_HOST" --action="$action" &>/dev/null; then
        LAST_COMMAND="$name"
    else
        LAST_COMMAND="$name (failed)"
    fi
    draw_remote
    flush_input
}

draw_centered() {
    local row=$1 text=$2
    local visible=$(print -n "$text" | sed 's/\x1b\[[0-9;]*m//g')
    move_to "$row" $(( (TERM_COLS - ${#visible}) / 2 ))
    print -n "$text"
}

draw_remote() {
    tput clear
    get_term_size

    if (( TERM_COLS < MIN_COLS || TERM_ROWS < MIN_ROWS )); then
        draw_centered $((TERM_ROWS / 2)) "Terminal too small (${MIN_COLS}x${MIN_ROWS} min)"
        return
    fi

    local row=$(( (TERM_ROWS - 20) / 2 ))

    # All lines: exactly 38 visible chars between ║ borders
    draw_centered $row "${BLUE}╔══════════════════════════════════════╗${RESET}"; ((row++))
    draw_centered $row "${BLUE}║          ${BOLD}${WHITE}SIMPLE KODI REMOTE${RESET}          ${BLUE}║${RESET}"; ((row++))
    draw_centered $row "${BLUE}╠══════════════════════════════════════╣${RESET}"; ((row++))
    draw_centered $row "${BLUE}║                                      ║${RESET}"; ((row++))
    draw_centered $row "${BLUE}║${RESET}               ${CYAN}[ ^ ]${RESET} ${DIM}i${RESET}                ${BLUE}║${RESET}"; ((row++))
    draw_centered $row "${BLUE}║${RESET}       ${DIM}h${RESET} ${CYAN}[ < ]${RESET}  ${CYAN}[OK]${RESET}${DIM}a${RESET}  ${CYAN}[ > ]${RESET} ${DIM}l${RESET}        ${BLUE}║${RESET}"; ((row++))
    draw_centered $row "${BLUE}║${RESET}               ${CYAN}[ v ]${RESET} ${DIM}d${RESET}                ${BLUE}║${RESET}"; ((row++))
    draw_centered $row "${BLUE}║                                      ║${RESET}"; ((row++))
    draw_centered $row "${BLUE}║${RESET}   ${DIM}↑p${RESET} ${CYAN}Prev${RESET}    ${DIM}k/spc${RESET} ${CYAN}Play${RESET}    ${CYAN}Next${RESET} ${DIM}n↓${RESET}   ${BLUE}║${RESET}"; ((row++))
    draw_centered $row "${BLUE}║                                      ║${RESET}"; ((row++))
    draw_centered $row "${BLUE}║${RESET}     ${DIM}←,<${RESET} ${CYAN}Seek<<${RESET}        ${CYAN}>>Seek${RESET} ${DIM}>.→${RESET}     ${BLUE}║${RESET}"; ((row++))
    draw_centered $row "${BLUE}║                                      ║${RESET}"; ((row++))
    draw_centered $row "${BLUE}║${RESET}          ${DIM}-${RESET} ${CYAN}Vol-${RESET}      ${CYAN}Vol+${RESET} ${DIM}+${RESET}          ${BLUE}║${RESET}"; ((row++))
    draw_centered $row "${BLUE}║                                      ║${RESET}"; ((row++))
    draw_centered $row "${BLUE}║${RESET}          ${DIM}s${RESET} ${CYAN}Stop${RESET}      ${CYAN}Mute${RESET} ${DIM}m${RESET}          ${BLUE}║${RESET}"; ((row++))
    draw_centered $row "${BLUE}║                                      ║${RESET}"; ((row++))
    draw_centered $row "${BLUE}║${RESET}      ${DIM}b/bksp${RESET} ${CYAN}Back${RESET}      ${CYAN}Home${RESET} ${DIM}g${RESET}         ${BLUE}║${RESET}"; ((row++))
    draw_centered $row "${BLUE}║                                      ║${RESET}"; ((row++))
    draw_centered $row "${BLUE}╚══════════════════════════════════════╝${RESET}"; ((row++))

    draw_centered $row "${DIM}[q/esc] Quit${RESET}"; ((row+=2))

    local color="${GREEN}"
    [[ "$LAST_COMMAND" == *"(failed)"* ]] && color="${YELLOW}"
    if [[ -n "$LAST_TIMESTAMP" ]]; then
        draw_centered $row "Last command ${DIM}[${LAST_TIMESTAMP}]${RESET}: ${color}${LAST_COMMAND}${RESET}"
    else
        draw_centered $row "Last command: ${color}${LAST_COMMAND}${RESET}"
    fi
}

# Read one logical keypress into the global KEY. With an optional timeout
# (seconds, may be fractional) it returns non-zero if nothing arrives in time.
read_key() {
    local timeout="${1:-}" k e1 e2
    if [[ -n "$timeout" ]]; then
        IFS= read -rsk1 -t "$timeout" k || return 1
    else
        IFS= read -rsk1 k || return 1
    fi

    if [[ "$k" == $'\x1b' ]]; then
        IFS= read -rsk1 -t 0.1 e1 || { KEY="ESC"; return 0; }
        IFS= read -rsk1 -t 0.1 e2 || { KEY="ESC"; return 0; }
        case "$e1$e2" in
            "[A") k="UP" ;;    "[B") k="DOWN" ;;
            "[C") k="RIGHT" ;; "[D") k="LEFT" ;;
            "[H") k="HOME" ;;  *) k="UNKNOWN" ;;
        esac
    fi

    [[ "$k" == $'\x7f' || "$k" == $'\x08' ]] && k="BACKSPACE"
    [[ "$k" == "" ]] && k="ENTER"
    KEY="$k"
    return 0
}

# Register a seek tap. Taps in the same direction within SEEK_WINDOW double
# the amount: 1 tap = 2s, 2 = 4s, 3 = 8s, 4 = 16s, ... for as long as the
# burst continues. The actual Seek() fires from flush_seek once the burst
# goes quiet, so rapid taps never queue network round-trips.
seek_tap() {
    local dir=$1 now=$EPOCHREALTIME
    if (( SEEK_DIR == dir && now < SEEK_DEADLINE )); then
        # Sanity cap: 2^16 = 65536s (~18h) is beyond any media
        if (( SEEK_COUNT < 16 )); then
            (( SEEK_COUNT += 1 ))
        fi
    else
        flush_seek
        SEEK_DIR=$dir
        SEEK_COUNT=1
    fi
    SEEK_DEADLINE=$(( now + SEEK_WINDOW ))

    local secs=$(( 2 ** SEEK_COUNT )) sign="+"
    (( dir < 0 )) && sign="-"
    LAST_TIMESTAMP=$(date +%H:%M:%S)
    LAST_COMMAND="Seek ${sign}${secs}s (tap ${SEEK_COUNT})..."
    draw_remote
}

# Commit a pending seek burst as a single relative Seek(seconds).
flush_seek() {
    (( SEEK_DIR != 0 )) || return 0
    local amt=$(( SEEK_DIR * 2 ** SEEK_COUNT )) sign=""
    (( amt > 0 )) && sign="+"
    SEEK_DIR=0
    SEEK_COUNT=0
    send_kodi "Seek($amt)" "Seek ${sign}${amt}s"
}

dispatch_key() {
    local key="$1"
    case "$key" in
        ">"|"."|RIGHT) seek_tap 1 ;;
        "<"|","|LEFT)  seek_tap -1 ;;
        *)
            flush_seek  # any other key commits a pending seek first
            case "$key" in
                i)           send_kodi "Action(Up)" "Up" ;;
                d)           send_kodi "Action(Down)" "Down" ;;
                h)           send_kodi "Action(Left)" "Left" ;;
                l)           send_kodi "Action(Right)" "Right" ;;
                ENTER|a)     send_kodi "Action(Select)" "Select" ;;
                " "|k)       send_kodi "PlayerControl(Play)" "Play/Pause" ;;
                s)           send_kodi "PlayerControl(Stop)" "Stop" ;;
                p|UP)        send_kodi "PlayerControl(Previous)" "Previous" ;;
                n|DOWN)      send_kodi "PlayerControl(Next)" "Next" ;;
                "+"|"=")     send_kodi "Action(VolumeUp)" "Vol+" ;;
                "-"|"_")     send_kodi "Action(VolumeDown)" "Vol-" ;;
                m)           send_kodi "Mute" "Mute" ;;
                BACKSPACE|b) send_kodi "Action(Back)" "Back" ;;
                HOME|g)      send_kodi "ActivateWindow(Home)" "Home" ;;
                q|Q|ESC)     exit 0 ;;
            esac
            ;;
    esac
}

# Main event loop. When a seek burst is pending, read with a timeout so the
# burst commits once SEEK_WINDOW elapses with no further tap.
event_loop() {
    local remaining
    while true; do
        if (( SEEK_DIR != 0 )); then
            remaining=$(( SEEK_DEADLINE - EPOCHREALTIME ))
            (( remaining > 0 )) || remaining=0
            if read_key "$remaining"; then
                dispatch_key "$KEY"
            else
                flush_seek
            fi
        else
            if read_key; then
                dispatch_key "$KEY"
            fi
        fi
    done
}

main() {
    load_config
    check_deps
    # cleanup runs on EXIT; signal traps must exit explicitly or zsh
    # resumes the interrupted input loop after the handler returns
    trap cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    trap draw_remote SIGWINCH
    stty -echo -icanon
    tput civis
    draw_remote
    event_loop
}

main "$@"
